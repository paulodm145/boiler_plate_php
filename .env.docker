APP_NAME="App Boilerplate"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8002
APP_INSTALLED=false

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=user
DB_PASSWORD=password
DB_CHARSET=utf8mb4

# Senha do root do MySQL dentro do container (uso administrativo/local only).
DB_ROOT_PASSWORD=root
