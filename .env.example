APP_NAME="App Boilerplate"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8002

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=user
DB_PASSWORD=password
DB_CHARSET=utf8mb4

# Log em storage/logs/app-AAAA-MM-DD.log (data UTC).
# Nivel: debug|info|warning|error|critical; padrao: debug com APP_DEBUG=true, senao warning
LOG_LEVEL=debug
LOG_RETENTION_DAYS=14

# SMTP opcional: quando definidas, tem prioridade sobre a tela Configuracoes,
# campo a campo (assim a senha do e-mail de producao fica fora do banco).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=
# SMTP_FROM_NAME="App Boilerplate"
