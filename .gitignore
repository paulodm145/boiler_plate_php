.env
.env.install
/public/uploads/*
!/public/uploads/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
/database/*.sql
/vendor/
/node_modules/
/storage/logs/
/.idea/
/.vscode/

/.superpowers/

# Notas internas de planejamento (specs/plans) geradas durante o
# desenvolvimento assistido — nao sao documentacao do projeto.
/docs/superpowers/plans/*
!/docs/superpowers/plans/.gitkeep
/docs/superpowers/specs/*
!/docs/superpowers/specs/.gitkeep

# Artefatos locais de ferramentas de IA/agentes — estado de sessao, nao
# conteudo do projeto. As skills em .claude/skills e .agents/skills ficam
# versionadas de proposito, pra qualquer projeto derivado deste boilerplate
# ja ter os fluxos disponiveis sem redescobri-los.
/.claude/*
!/.claude/skills/
/.agents/*
!/.agents/skills/
/skills-lock.json
.codex
